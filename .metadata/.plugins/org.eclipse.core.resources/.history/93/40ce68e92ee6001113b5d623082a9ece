	@PostMapping
	public ResponseEntity<Object> save(@RequestBody BranchProducts branchProducts) {
		Map<String, Object> map = new HashMap<>();
		try {
			if (branchProducts.getIdBranch() == null || branchProducts.getIdProduct() == null) {
				map.put("message", "idBranch e idProduct son obligatorios");
				return new ResponseEntity<>(map, HttpStatus.BAD_REQUEST);
			}

			// Validar que existan sucursal y producto
			if (branchService.findById(branchProducts.getIdBranch()) == null) {
				map.put("message", "La sucursal con id " + branchProducts.getIdBranch() + " no existe");
				return new ResponseEntity<>(map, HttpStatus.NOT_FOUND);
			}

			if (productService.findById(branchProducts.getIdProduct()) == null) {
				map.put("message", "El producto con id " + branchProducts.getIdProduct() + " no existe");
				return new ResponseEntity<>(map, HttpStatus.NOT_FOUND);
			}

			// Opcional: validar si ya existe la relación sucursal-producto
			if (branchProductsService.existsByIdBranchAndIdProduct(
					branchProducts.getIdBranch(), branchProducts.getIdProduct())) {
				map.put("message", "Ese producto ya está registrado en la sucursal");
				return new ResponseEntity<>(map, HttpStatus.CONFLICT);
			}

			BranchProducts data = branchProductsService.save(branchProducts);
			return new ResponseEntity<>(data, HttpStatus.CREATED);
		} catch (Exception e) {
			map.put("message", e.getMessage());
			return new ResponseEntity<>(map, HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}

	@PutMapping("/{id}")
	public ResponseEntity<Object> update(@PathVariable Long id, @RequestBody BranchProducts branchProducts) {
		Map<String, Object> map = new HashMap<>();
		try {
			BranchProducts existing = branchProductsService.findById(id);
			if (existing == null) {
				map.put("message", "BranchProducts not found");
				return new ResponseEntity<>(map, HttpStatus.NOT_FOUND);
			}
			branchProducts.setIdBranch(id);
			BranchProducts updated = branchProductsService.save(branchProducts);
			return new ResponseEntity<>(updated, HttpStatus.OK);
		} catch (Exception e) {
			map.put("message", e.getMessage());
			return new ResponseEntity<>(map, HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}

	@DeleteMapping(value = "/{id}")
	public ResponseEntity<Object> delete(@PathVariable Long id) {
		Map<String, Object> map = new HashMap<>();
		try {
			BranchProducts data = branchProductsService.findById(id);
			branchProductsService.delete(data);
			map.put("message", "Branch Products deleted successfully");
			return new ResponseEntity<>(map, HttpStatus.OK);
		} catch (Exception e) {
			map.put("message", e.getMessage());
			return new ResponseEntity<>(map, HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}
	
}
